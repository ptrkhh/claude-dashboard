# Cloudflare Zero Trust → Networks → Tunnels. Create the tunnel, then copy its token.
TUNNEL_TOKEN=

# Cloudflare Zero Trust → Access → Applications. The team domain is the issuer
# shown on the application, e.g. https://example.cloudflareaccess.com
CF_TEAM_DOMAIN=
# Application Audience (AUD) tag of that Access application.
CF_AUD=

# Host directory to mount at /projects in the container.
PROJECTS_DIR=./projects
