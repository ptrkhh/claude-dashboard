# Cloudflare Zero Trust → Networks → Tunnels. Create the tunnel, then copy its token.
TUNNEL_TOKEN=

# Required: the full HTTPS issuer URL, including https:// and no trailing slash.
# Cloudflare Zero Trust → Access → Applications, e.g. https://example.cloudflareaccess.com
CF_TEAM_DOMAIN=
# Application Audience (AUD) tag of that Access application.
CF_AUD=

# Host directory to mount at /home/node/projects in the container.
PROJECTS_DIR=./projects
